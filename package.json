{
  "name": "cariocas-pro",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "check:orthography": "node scripts/check-ui-orthography.mjs",
    "fix:orthography": "node scripts/check-ui-orthography.mjs --write",
    "test": "node --import tsx --test tests/unit/*.test.ts",
    "test:integration": "node --import tsx --test tests/integration/*.test.ts",
    "test:emulators": "npx --yes firebase-tools@13.35.1 emulators:exec --config firebase.test.json --project demo-cariocas-pro --only firestore,auth \"npm run test:integration\"",
    "test:ui": "node tests/ui/insumo-form.mjs",
    "test:app": "npx --yes firebase-tools@13.35.1 emulators:exec --config firebase.test.json --project demo-cariocas-pro --only firestore,auth \"node tests/ui/application-flow.mjs\""
  },
  "dependencies": {
    "firebase": "^11.10.0",
    "firebase-admin": "^13.10.0",
    "next": "^15.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "playwright": "^1.62.1",
    "tsx": "^4.23.15",
    "typescript": "^5.6.0"
  }
}
